# ============================================================
# Family Medicare Clinic & Laboratory — Environment Example
# ============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your real values
# 3. NEVER commit .env to Git — only commit .env.example
# ============================================================

# ── Database ──
#
# XAMPP (local development):
#   DB_HOST=localhost
#   DB_USER=root
#   DB_PASS=           ← leave blank, XAMPP default
#   DB_NAME=family_medicare
#
# Hostinger (production):
#   DB_HOST=localhost
#   DB_USER=u123456789_username   ← from hPanel > MySQL Databases
#   DB_PASS=YourStrongPassword
#   DB_NAME=u123456789_medicare   ← from hPanel > MySQL Databases

DB_HOST=localhost
DB_NAME=family_medicare
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Application ──
APP_NAME="Family Medicare Clinic & Laboratory"
APP_TIMEZONE=Africa/Nairobi

# ── Debug ──
# Use true on XAMPP. MUST be false on Hostinger/production.
APP_DEBUG=true

# ── Alerts ──
ALERT_EMAIL=fammedicare810@gmail.com
